# =============================================================================
# Campus Carbon Twin - environment variable template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real credentials.
# =============================================================================

# --- Spring Boot backend ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# --- Supabase (backend / service role) ---
# Used by Spring Boot ONLY.  Never put this in frontend code.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_NEVER_IN_FRONTEND

# --- Supabase JWT verification (Spring Boot) ---
# Found in: Supabase Dashboard > Settings > API > JWT Settings > JWT Secret
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET

# --- Gemini LLM API (action explanations) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Frontend (Vite) ---
# These values ARE bundled into the browser build; use only publishable keys.
VITE_API_URL=http://localhost:8080/api/v1
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_ANON_PUBLISHABLE_KEY

# VITE_SUPABASE_PUBLISHABLE_KEY must be the anon key shown in:
#   Supabase Dashboard > Settings > API > Project API keys > anon (public)
# The service_role key must NEVER appear here.

# --- Camera edge (optional local override) ---
VITE_ENABLE_MOCK_EDGE=true
