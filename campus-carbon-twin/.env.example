# ==============================================================================
# Campus Carbon Twin - Environment Configuration Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT (Safe for browser bundle - Public / Publishable Keys)
# ------------------------------------------------------------------------------
# Supabase project URL (publishable)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable anon public key (restricted by PostgreSQL RLS)
# WARNING: NEVER place your service_role secret key in VITE_* environment variables!
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# Backend API base URL
VITE_API_URL=http://localhost:8080/api/v1

# Edge Camera Mock Toggle (true = simulated inference fallback, false = real camera stream)
VITE_ENABLE_MOCK_EDGE=true

# ------------------------------------------------------------------------------
# 2. BACKEND SERVER CONFIGURATION (Private / Server-Side Only)
# ------------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Supabase backend credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_NEVER_IN_FRONTEND

# Supabase JWT Resource Server Verification (Spring Boot)
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWK_SET_URI=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_SECRET=your_jwt_secret_here

# Direct PostgreSQL Database Connection (Supabase Transaction Pooler / Direct)
DATABASE_URL=jdbc:postgresql://your-project.supabase.co:5432/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_secure_db_password

# Gemini LLM API (for Action Explanations)
GEMINI_API_KEY=your_gemini_api_key_here
